# Supabase pooled connection string for runtime/Vercel.
# Use the URI from Supabase: Connect > ORMs > Prisma, preferably the pooler URI.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase direct connection string for Prisma migrations and db push.
# Use the direct URI from Supabase: Connect > ORMs > Prisma.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Secret used to sign session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-32-byte-hex-string"

# Public base URL, used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Discord approval channel (optional).
#
# Leave every value blank to switch the integration off entirely: with no bot
# token nothing is posted, the interactions endpoint answers 503, and the app
# behaves exactly as it did before the integration existed. This is the state
# the test suite runs in, which is what keeps it offline.
#
# Buttons require a Discord *Application*, not a channel webhook — components
# can only be sent by an application-owned message, and clicks are delivered to
# the Interactions Endpoint URL below. Set it to:
#   <your public origin>/api/discord/interactions
# Discord validates that URL when you save it, so a green save means signature
# verification is working.
#
# The bot needs VIEW_CHANNEL and SEND_MESSAGES in the approvals channel.
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_APPLICATION_ID=""
DISCORD_GUILD_ID=""
DISCORD_APPROVALS_CHANNEL_ID=""
